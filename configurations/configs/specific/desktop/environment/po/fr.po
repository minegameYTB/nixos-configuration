msgstr "Les menus tombent droit depuis la barre au lieu de pointer vers le bouton"

#: prefsPages/appearancePage.js:160
msgid "Menu Bar"
msgstr "Barre de menus"

#: prefsPages/appearancePage.js:164
msgid "Button spacing"
msgstr "Espacement des boutons"

