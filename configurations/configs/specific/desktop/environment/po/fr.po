#: prefsPages/appearancePage.js:106
msgid "Popup Blur"
msgstr "Flou des menus contextuels"

#: prefsPages/appearancePage.js:108
msgid ""
"Blurs what is behind popup menus, through Blur My Shell. The panel bar "
"itself is blurred by Blur My Shell's own \"Panel\" setting."
msgstr "Floute l'arrière-plan des menus contextuels, via Blur My Shell. La barre du panneau est elle-même floutée par le réglage « Panel » de Blur My Shell."

#: prefsPages/appearancePage.js:109
msgid "Blur My Shell is not installed, so these options will have no effect."
msgstr "Blur My Shell n'est pas installé : ces options n'auront donc aucun effet."

#: prefsPages/appearancePage.js:114
msgid "Blur behind popup menus"
msgstr "Flouter derrière les menus contextuels"

#: prefsPages/appearancePage.js:115
msgid "Dynamic blur: re-rendered as the content behind moves"
msgstr "Flou dynamique : recalculé quand le contenu derrière bouge"

#: prefsPages/appearancePage.js:121
msgid "Blur intensity"
msgstr "Intensité du flou"

#: prefsPages/appearancePage.js:122
msgid "Sigma of the gaussian blur"
msgstr "Sigma du flou gaussien"

#: prefsPages/appearancePage.js:126
msgid "Brightness"
msgstr "Luminosité"

#: prefsPages/appearancePage.js:127
msgid "1.00 = no dimming of the blurred area"
msgstr "1,00 = aucune atténuation de la zone floutée"

#: prefsPages/appearancePage.js:137
