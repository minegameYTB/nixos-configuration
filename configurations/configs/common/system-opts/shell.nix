{ config, pkgs, ... }:

{
  ### Active shell
  users.defaultUserShell = pkgs.zsh;

  ### Prompt plumbing: starship init for zsh (system-managed — ~/.zshrc is only
  ### a home-manager stub). The config file itself (tokyo-night preset + NixOS
  ### logo) is generated by home-manager in home-manager/features/shell.nix
  ### → ~/.config/starship.toml, i.e. starship's default location, read
  ### identically by every shell (zsh skips its own STARSHIP_CONFIG export when
  ### that file exists).
  ### Replaces the old personalisations:
  ###   - oh-my-zsh "agnoster" theme (commented out below),
  ###   - nix_shell RPROMPT indicator (removed),
  ###   - custom bash PS1 (home-manager/features/shell.nix, commented out).
  programs.starship = {
    enable = true;
    ### bash is initialised from home-manager (its ~/.bashrc does not read
    ### /etc/bashrc):
    enableBashIntegration = false;
  };

  ### Configurations
  programs.zsh = {
    enable = true;
    enableBashCompletion = true;
    vteIntegration = true;
    interactiveShellInit = ''
      #VM_OPTS="$(echo '-smp 2 -m 4096 -spice port=3001,disable-ticketing=on -device virtio-vga -display gtk')"
    '';
    syntaxHighlighting = {
      enable = true;
      highlighters = [
        "main"
      ];
      styles = {
        "comment" = "fg=red,bold";
        "unknown-token" = "fg=red";
      };
    };
    autosuggestions = {
      enable = true;
      strategy = [ "match_prev_cmd" ];
    };
    ### Old prompt theme — replaced by starship (commented out):
    #ohMyZsh = {
    #  enable = true;
    #  theme = "agnoster";
    #};
  };
}
