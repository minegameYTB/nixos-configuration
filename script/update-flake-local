#!/usr/bin/env bash
### update-flake-local — refresh flake inputs without any git interaction.
###
### For testers without push access (or without a .git checkout at all):
### updates flake.lock in the working tree and leaves it uncommitted.
### This script never invokes git — safe on tarballs and read-only clones.
### Run from the repository root.
set -euo pipefail

require_cmd(){
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "error: '$cmd' not found in PATH" >&2
    exit 1
  fi
}

check_root(){
  if [[ ! -f flake.nix || ! -f flake.lock ]]; then
    echo "error: flake.nix/flake.lock not found — run from the repository root" >&2
    exit 1
  fi
}

update_flake(){
  echo -e "\nUpdate repo flake (local only, no commit, no push)\n"
  nix flake update --flake .
}

show_new_rev(){
  echo -e "\nNew revision (flake.lock updated in working tree, not committed)\n"
  local rev nixpkgs_version
  rev=$(jq -r '.nodes."nixpkgs-main".locked.rev' flake.lock)
  nixpkgs_version=$(nix eval --raw "github:NixOS/nixpkgs/${rev}#lib.version")
  echo "nixpkgs-main: ${rev} (version ${nixpkgs_version})"
}

main(){
  require_cmd nix
  require_cmd jq
  check_root
  update_flake
  show_new_rev
  echo -e "\nDone — test with: sudo nixos-rebuild build --flake .#<machine>"
}

### Execute the main function
main
