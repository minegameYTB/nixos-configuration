#!/usr/bin/env bash
set -euo pipefail

# Only run on branch checkout (not file checkout)
# $3 = 1 for branch checkout, 0 for file checkout
is_branch_checkout="${3:-0}"

if [ "$is_branch_checkout" != "1" ]; then
  exit 0
fi

branch=$(git branch --show-current)

if [ -n "$branch" ]; then
  printf '%s' "$branch" > .branch
  git add .branch

  if ! git diff --cached --exit-code -- .branch >/dev/null 2>&1; then
    git commit -m ".branch: change branch" --no-verify
  fi
fi
